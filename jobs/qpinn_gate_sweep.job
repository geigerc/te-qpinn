#!/bin/bash
#SBATCH --job-name=qpinn_gate_sweep
#SBATCH --account=education-ae-bsc-lr
#SBATCH --partition=gpu-a100-small
#SBATCH --gpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=8000M
#SBATCH --array=0-3
#SBATCH --output=logs/gate_sweep_%A_%a.out
#SBATCH --error=logs/gate_sweep_%A_%a.err

cd $SLURM_SUBMIT_DIR

source .venv/bin/activate
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export MKL_NUM_THREADS=2
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=true intra_op_parallelism_threads=2"

GATES=("cry" "cnot" "cz" "isingzz")
CURRENT_GATE=${GATES[$SLURM_ARRAY_TASK_ID]}

BASE_CONFIG="cfgs/template.toml"
TMP_CONFIG="cfgs/tmp_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.toml"
OUT_DIR="rez/gate_${CURRENT_GATE}"

mkdir -p "$OUT_DIR"

trap 'rm -f "$TMP_CONFIG"' EXIT

sed -e "s/gate = .*/gate = \"${CURRENT_GATE}\"/" \
    -e "s/mapping = .*/mapping = \"first\"/" \
    -e "s/run_name = .*/run_name = \"gate_${CURRENT_GATE}\"/" \
    "$BASE_CONFIG" > "$TMP_CONFIG"

echo "[$(date +%H:%M:%S)] launching gate ${CURRENT_GATE} (task ${SLURM_ARRAY_TASK_ID})"
python qpinn_sweepable.py -c "$TMP_CONFIG" -o "$OUT_DIR"

echo "[$(date +%H:%M:%S)] done."
