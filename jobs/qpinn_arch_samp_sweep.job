#!/bin/bash
#SBATCH --job-name=arch_samp_sweep_new
#SBATCH --account=education-ae-bsc-lr
#SBATCH --partition=gpu-a100
#SBATCH --gpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=4000M
#SBATCH --array=0-7
#SBATCH --output=logs/arch_samp_sweep_new_%A_%a.out
#SBATCH --error=logs/arch_samp_sweep_new_%A_%a.err

cd $SLURM_SUBMIT_DIR

source .venv/bin/activate
export OMP_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

ARCHITECTURES=("separate" "shared")
SAMPLINGS=("uniform" "chebytto" "power" "asymm_tanh")

ARCH_IDX=$(( SLURM_ARRAY_TASK_ID / 4 ))
SAMP_IDX=$(( SLURM_ARRAY_TASK_ID % 4 ))

CURRENT_ARCH=${ARCHITECTURES[$ARCH_IDX]}
CURRENT_SAMPLING=${SAMPLINGS[$SAMP_IDX]}

RUN_NAME="${CURRENT_ARCH}_${CURRENT_SAMPLING}"
BASE_CONFIG="cfgs/template.toml"
TMP_CONFIG="cfgs/tmp_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.toml"
OUT_DIR="rez/${RUN_NAME}"

mkdir -p "$OUT_DIR" logs

trap 'rm -f "$TMP_CONFIG"' EXIT

sed -e "s/mode = .*/mode = \"${CURRENT_ARCH}\"/" \
    -e "s/sampling = .*/sampling = \"${CURRENT_SAMPLING}\"/" \
    -e "s/run_name = .*/run_name = \"${RUN_NAME}\"/" \
    "$BASE_CONFIG" > "$TMP_CONFIG"

echo "[$(date +%H:%M:%S)] launching ${RUN_NAME} (task ${SLURM_ARRAY_TASK_ID})"
python qpinn_sweepable.py -c "$TMP_CONFIG" -o "$OUT_DIR"

echo "[$(date +%H:%M:%S)] done."
