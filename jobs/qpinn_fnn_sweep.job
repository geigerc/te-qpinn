#!/bin/bash
#SBATCH --job-name=fnn_sweep
#SBATCH --account=education-ae-bsc-lr
#SBATCH --partition=gpu-a100
#SBATCH --gpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem-per-cpu=2000M
#SBATCH --array=0-23
#SBATCH --output=logs/fnn_sweep_%A_%a.out
#SBATCH --error=logs/fnn_sweep_%A_%a.err

cd "$SLURM_SUBMIT_DIR" || exit 1

source .venv/bin/activate
export OMP_NUM_THREADS=32
export OPENBLAS_NUM_THREADS=32
export MKL_NUM_THREADS=32

CONFIGS_DEPTH=("0" "1" "1" "1" "1" "2" "2" "2")
CONFIGS_WIDTH=("1" "2" "3" "4" "8" "3" "8" "20")

SEEDS=("4444" "4448" "4488")

NUM_SEEDS=${#SEEDS[@]}

# Total array size required: 8 configs * 3 seeds = 24 tasks (--array=0-23)
CFG_IDX=$(( SLURM_ARRAY_TASK_ID / NUM_SEEDS ))
SEED_IDX=$(( SLURM_ARRAY_TASK_ID % NUM_SEEDS ))

CURRENT_DEPTH=${CONFIGS_DEPTH[$CFG_IDX]}
CURRENT_WIDTH=${CONFIGS_WIDTH[$CFG_IDX]}
CURRENT_SEED=${SEEDS[$SEED_IDX]}

RUN_NAME="fnn_d${CURRENT_DEPTH}_w${CURRENT_WIDTH}_s${CURRENT_SEED}"
BASE_CONFIG="cfgs/template.toml"
TMP_CONFIG="cfgs/tmp_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.toml"
OUT_DIR="rez/${RUN_NAME}"

trap 'rm -f "$TMP_CONFIG"' EXIT

sed -e "s/^depth = .*/depth = ${CURRENT_DEPTH}/" \
    -e "s/^width = .*/width = ${CURRENT_WIDTH}/" \
    -e "s/^seed = .*/seed = ${CURRENT_SEED}/" \
    -e "s/^run_name = .*/run_name = \"${RUN_NAME}\"/" \
    "$BASE_CONFIG" > "$TMP_CONFIG"

echo "[$(date +%H:%M:%S)] launching ${RUN_NAME} | depth=${CURRENT_DEPTH}, width=${CURRENT_WIDTH}, seed=${CURRENT_SEED} (Task ${SLURM_ARRAY_TASK_ID})"
python qpinn_sweepable.py -c "$TMP_CONFIG" -o "$OUT_DIR"

echo "[$(date +%H:%M:%S)] done ${RUN_NAME}."
