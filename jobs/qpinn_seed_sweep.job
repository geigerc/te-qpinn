#!/bin/bash
#SBATCH --job-name=seed_control_sweep
#SBATCH --account=education-ae-bsc-lr
#SBATCH --partition=gpu-a100
#SBATCH --gpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu=2000M
#SBATCH --array=0-14
#SBATCH --output=logs/seed_control_sweep_%j.out
#SBATCH --error=logs/seed_control_sweep_%j.err

cd "$SLURM_SUBMIT_DIR" || exit 1

source .venv/bin/activate
export OMP_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=16
export MKL_NUM_THREADS=16

MAPPINGS=("full" "first" "custom")
SEEDS=("4444" "4448" "4488" "4888" "8888")

MAPP_IDX=$(( SLURM_ARRAY_TASK_ID / 5 ))
SEED_IDX=$(( SLURM_ARRAY_TASK_ID % 5 ))

CURRENT_MAPP=${MAPPINGS[$MAPP_IDX]}
CURRENT_SEED=${SEEDS[$SEED_IDX]}

RUN_NAME="separate_chebytto_${CURRENT_MAPP}_${CURRENT_SEED}"
BASE_CONFIG="cfgs/template.toml"
TMP_CONFIG="cfgs/tmp_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.toml"
OUT_DIR="rez/${RUN_NAME}"

trap 'rm -f "$TMP_CONFIG"' EXIT

sed -e "s/mapping = .*/mapping = \"${CURRENT_MAPP}\"/" \
    -e "s/seed = .*/seed = ${CURRENT_SEED}/" \
    -e "s/run_name = .*/run_name = \"${RUN_NAME}\"/" \
    "$BASE_CONFIG" > "$TMP_CONFIG"

echo "[$(date +%H:%M:%S)] launching ${RUN_NAME} (task ${SLURM_ARRAY_TASK_ID})"
python qpinn_sweepable.py -c "$TMP_CONFIG" -o "$OUT_DIR"

echo "[$(date +%H:%M:%S)] done."
