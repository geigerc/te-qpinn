#!/bin/bash
#SBATCH --job-name=qpinn_reup_sweep
#SBATCH --account=education-ae-bsc-lr
#SBATCH --partition=gpu-a100-small
#SBATCH --gpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=4G
#SBATCH --array=0-4
#SBATCH --output=logs/sweep_%A_%a.out
#SBATCH --error=logs/sweep_%A_%a.err

cd $SLURM_SUBMIT_DIR

source .venv/bin/activate

MAPPINGS=("full" "alternating" "per-wire" "first" "last")
CURRENT_MAPPING=${MAPPINGS[$SLURM_ARRAY_TASK_ID]}

BASE_CONFIG="cfgs/template.toml"
TMP_CONFIG="cfgs/tmp_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.toml"
OUT_DIR="rez/${CURRENT_MAPPING}"

mkdir -p "$OUT_DIR"

trap 'rm -f "$TMP_CONFIG"' EXIT

sed -e "s/mapping = .*/mapping = \"${CURRENT_MAPPING}\"/" \
    -e "s/run_name = .*/run_name = \"run_${CURRENT_MAPPING}\"/" \
    "$BASE_CONFIG" > "$TMP_CONFIG"

echo "[$(date +%H:%M:%S)] launching  ${CURRENT_MAPPING} (task ${SLURM_ARRAY_TASK_ID})"
python qpinn_sweepable.py -c "$TMP_CONFIG" -o "$OUT_DIR"

echo "[$(date +%H:%M:%S)] done."
